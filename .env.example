# Discord webhook to send notifications to. Leave unset to disable Discord.
DISCORD_WEBHOOK_URL = "URL to Discord webhook goes here"

# Path to write an RSS feed file to. Leave unset to disable the feed.
# RSS_FEED_PATH = "/path/to/comets.xml"

# scp destination that run.sh uploads the feed, page and CSV to. Leave unset to skip uploading.
# DEPLOY_TARGET = "user@host:/var/www/site"
